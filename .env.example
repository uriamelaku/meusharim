# Copy to .env (cp .env.example .env). Local development only.
# Never put real/production credentials or secret keys in this file.
POSTGRES_USER=meusharim
POSTGRES_PASSWORD=meusharim
POSTGRES_DB=meusharim

# Supabase dev project (meusharim-dev). Used only for authentication.
# Both values are public: the publishable key is meant to be shipped to the browser.
SUPABASE_URL=https://lvjcuabkouvoisrkawhw.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Optional, for deployments where frontend and API are on different domains
# (see docs/deployment.md). Leave unset locally: the Vite dev server proxies /api.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# VITE_API_BASE_URL=https://your-api.example.com
